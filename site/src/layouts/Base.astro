---
// Fonts are self-hosted from the build (hashed files in /_astro/, cached as immutable). Declared here instead of
// through the Fontsource CSS, whose font-display: swap flashed the fallback font on every page load (user
// 2026-10-25): the two text fonts are preloaded and use font-display: fallback, so a cached font is there for the
// first paint. Latin plus latin-ext covers Czech. Mynerve (home page only) is preloaded there too: loaded late, it
// missed the fallback window and was dropped (user 2026-10-25).
import grandLatin from "@fontsource-variable/grandstander/files/grandstander-latin-wght-normal.woff2?url";
import grandExt from "@fontsource-variable/grandstander/files/grandstander-latin-ext-wght-normal.woff2?url";
import outfitLatin from "@fontsource-variable/outfit/files/outfit-latin-wght-normal.woff2?url";
import outfitExt from "@fontsource-variable/outfit/files/outfit-latin-ext-wght-normal.woff2?url";
import mynerveLatin from "@fontsource/mynerve/files/mynerve-latin-400-normal.woff2?url";
import mynerveExt from "@fontsource/mynerve/files/mynerve-latin-ext-400-normal.woff2?url";
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { iconSymbols } from "../lib/icons";

interface Props { title?: string; description?: string; search?: boolean; home?: boolean }
const { title, description = "U konkrétních věcí ze základní školy ukazujeme, proč se je učíš, jestli ti s nimi pomůže nějaký nástroj a v jakých povoláních se hodí.", search = true, home = false } = Astro.props;
const fullTitle = title ? `${title} · Proč se to učím?` : "Proč se to učím?";
const LATIN = "U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD";
const EXT = "U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF";
const face = (family: string, url: string, range: string, weight: string, variable = true) =>
  `@font-face{font-family:"${family}";font-style:normal;font-display:fallback;font-weight:${weight};src:url(${url}) format("${variable ? "woff2-variations" : "woff2"}");unicode-range:${range}}`;
const fontFaces = [
  face("Grandstander Variable", grandLatin, LATIN, "100 900"), face("Grandstander Variable", grandExt, EXT, "100 900"),
  face("Outfit Variable", outfitLatin, LATIN, "100 900"), face("Outfit Variable", outfitExt, EXT, "100 900"),
  face("Mynerve", mynerveLatin, LATIN, "400", false), face("Mynerve", mynerveExt, EXT, "400", false),
].join("");
const base = import.meta.env.BASE_URL;
const nav = [
  { href: `${base}predmety/`, label: "Předměty" },
  { href: `${base}povolani/`, label: "Povolání" },
  { href: `${base}nastroje/`, label: "Nástroje" },
  { href: `${base}kontakt/`, label: "Kontakt" },
  { href: `${base}o-projektu/`, label: "O projektu" },
];
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    {[grandLatin, grandExt, outfitLatin, outfitExt, ...(home ? [mynerveLatin, mynerveExt] : [])].map((u) => <link rel="preload" href={u} as="font" type="font/woff2" crossorigin />)}
    <style is:inline set:html={fontFaces} />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}favicon.ico`} sizes="48x48" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="icon" href={`${base}icon-192.png`} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    {/* Link previews: every page shares the top of the home page (public/og.png, made by scripts/og-image.py). */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Proč se to učím?" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta property="og:image" content={new URL(`${base}og.png`, Astro.site).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Proč se to učím? …když to za mě udělá AI chatbot" />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Semi-public (user 2026-10-20): reachable by link, kept out of search engines; nginx also sends X-Robots-Tag. */}
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <a class="skip visually-hidden" href="#obsah">Přeskočit na obsah</a>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <defs>
        <pattern id="hatch-blue" patternUnits="userSpaceOnUse" width="5" height="5" patternTransform="rotate(40)"><line x1="0" y1="0" x2="0" y2="5" stroke="#1d7b9a" stroke-width="1.8" /></pattern>
        <pattern id="hatch-red" patternUnits="userSpaceOnUse" width="5" height="5" patternTransform="rotate(40)"><line x1="0" y1="0" x2="0" y2="5" stroke="#c2255c" stroke-width="1.8" /></pattern>
        <Fragment set:html={iconSymbols} />
      </defs>
    </svg>
    <header class="top">
      <div class="wrap top-in">
        {/* The logo is hidden for now (user 2026-10-25), so the home page, which shows no brand name, has no brand link. */}
        {!home && <a class="brand" href={base} aria-label="Proč se to učím? Úvod">
          <span class="brand-name">Proč se to učím?</span>
        </a>}
        <nav class="menu" aria-label="Hlavní">
          {nav.map((n) => <a class="menu-link" href={n.href} aria-current={Astro.url.pathname.startsWith(n.href) ? "page" : undefined}><span>{n.label}</span></a>)}
          {search && <a class="menu-link menu-search" href={`${base}hledat/`}><Icon name="search" size="20" /><span>Hledat</span></a>}
          <a class="menu-link menu-gh" href="https://github.com/kasnerz/procsetoucim" rel="external" title="Zdrojový kód na GitHubu"><svg class="gh-mark" viewBox="0 0 16 16" width="20" height="20" role="img" aria-label="Zdrojový kód na GitHubu"><path fill="#000" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg></a>
        </nav>
      </div>
    </header>
    <main id="obsah">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap foot-in">
        <nav aria-label="Přehledy" class="foot-nav">
          {nav.map((n) => <a class="foot-link" href={n.href}>{n.label}</a>)}
        </nav>
        <p class="soft small">Obsah vychází z Rámcového vzdělávacího programu pro základní vzdělávání (NPI ČR), klasifikace ESCO (Evropská komise), indexu ILO o generativní AI a prognózy Cedefop. Odhady a texty jsou označené. <a href={`${base}o-projektu/`}>Zdroje a citace</a></p>
      </div>
    </footer>
    <script>
      // Long lists (ul.rows, except search results) show their first rows; "Ukázat více" below shows the next 50 each
      // time. Without JavaScript every row stays visible. data-limit overrides the first count, data-limit="0" turns
      // it off.
      const LIMIT = 12, STEP = 50;
      for (const ul of document.querySelectorAll<HTMLElement>("ul.rows:not(.results)")) {
        const items = [...ul.children] as HTMLElement[];
        const lim = ul.dataset.limit !== undefined ? Number(ul.dataset.limit) : LIMIT;
        if (!lim || items.length <= lim + 3) continue;
        let shown = lim;
        const show = () => items.forEach((li, i) => {
          li.classList.toggle("rows-extra", i >= shown);
          li.classList.toggle("rows-last", i === shown - 1 && shown < items.length);
        });
        show();
        const b = document.createElement("button");
        b.type = "button";
        b.className = "rows-more";
        b.textContent = "Ukázat více";
        b.addEventListener("click", () => {
          shown = Math.min(items.length, shown + STEP);
          show();
          if (shown >= items.length) b.remove();
        });
        ul.after(b);
      }
    </script>
  </body>
</html>

<style>
  .top { padding-top: env(safe-area-inset-top, 0px); }
  .top-in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--s2) var(--s5); padding-block: var(--s3); }
  .brand { display: inline-flex; align-items: center; gap: var(--s2); text-decoration: none; }
  .brand-name { font-family: var(--font-title); font-weight: var(--title-weight); font-size: calc(1.45rem * 0.95 * var(--title-scale)); line-height: 1; }
  .brand:hover .brand-name { text-decoration: underline; text-decoration-color: var(--pen); text-decoration-thickness: 3px; text-underline-offset: 0.15em; }
  .menu { margin-left: auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: var(--s1) var(--s4); }
  .menu-link { display: inline-flex; align-items: center; gap: 6px; padding: 6px 4px; font-size: 0.9375rem; font-weight: 600; text-decoration: none; color: var(--ink-soft); }
  .menu-link:hover span { color: var(--ink); text-decoration: underline; text-decoration-color: var(--pen); text-decoration-thickness: 2px; text-underline-offset: 0.25em; }
  .menu-link[aria-current="page"] { color: var(--ink); }
  .menu-link[aria-current="page"] span { background: var(--hl-red) 0 92% / 100% 0.7em no-repeat; padding-inline: 0.12em; }
  .menu-search { margin-left: var(--s2); }
  .menu-gh:hover .gh-mark { opacity: .75; }
  @media (max-width: 760px) {
    .top-in { justify-content: center; }
    .menu { justify-content: center; margin-inline: auto; }
    .menu { gap: 0 var(--s3); }
    .menu-link { padding: 4px 2px; font-size: 0.875rem; }
    .menu-search { margin-left: 0; }
  }
  main { padding-block: var(--s6) var(--s8); }
  .foot { background: var(--pen-stroke) center top / min(560px, 80%) 12px no-repeat; }
  .foot-in { display: grid; justify-items: center; text-align: center; gap: var(--s5); padding-block: var(--s6) calc(var(--s7) + env(safe-area-inset-bottom, 0px)); }
  .foot-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--s2) var(--s5); }
  .foot-link { font-weight: 600; text-decoration: none; }
  .foot-link:hover { text-decoration: underline; }
  .foot p { max-width: 64ch; }
  .skip:focus { position: fixed; left: 8px; top: 8px; width: auto; height: auto; clip: auto; margin: 0; padding: 8px 12px; background: #fff; border-radius: 10px; box-shadow: 0 0 0 2px var(--ink); z-index: 60; }
  @media (max-width: 520px) { .brand-name { font-size: calc(1.55rem * 0.95 * var(--title-scale)); } }
</style>
