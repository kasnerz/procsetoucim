---
// Home: what the site offers (user 2026-10-25), on one large squared sheet: two centred cards on plain paper,
// Témata and Povolání, each with three handwritten questions in accent 1 and a small pencil doodle (ink outlines, accent hatching from the patterns in Base.astro) and a link to its
// section. Before that the sheet held four scraps for kids, parents, teachers and the RVP team. Ends with the link to
// the project page. Mynerve is declared in Base.astro and loads only here.
import Paper from "./Paper.astro";
const base = import.meta.env.BASE_URL;
---

<section class="about" aria-labelledby="h-about">
  <Paper
    kind="grid"
    seed="home/about"
    tilt={-0.4}
    depth={4}
    class="about-sheet"
  >
    <h2 id="h-about" class="about-h">Škola má pořád smysl.</h2>
    <p class="about-note" aria-hidden="true">
      I když už řadu věcí AI umí lépe.
    </p>

    <div class="about-grid">
      <Paper
        as="a"
        href={`${base}predmety/`}
        seed="home/about/topics"
        tilt={1}
        depth={3}
        tone="#fff"
        class="offer topics"
      >
        <svg
          class="doodle"
          viewBox="0 0 120 96"
          aria-hidden="true"
          focusable="false"
        >
          <g
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="M60 36C46 28 29 28 14 32.5L15 82C29 78 46 78 60.5 86Z"
              fill="#fff"></path>
            <path
              d="M60 36C74 28 91 28 106 32L105.5 81.5C91 78 74 78 60.5 86Z"
              fill="#fff"></path>
            <path d="M60 36L60.5 86"></path>
            <path
              d="M23 45C31 43 41 43 51 46M23 55C31 53 40 53 51 56M23 65C30 63 37 63 44 65"
              stroke-width="1.6"
              opacity=".55"></path>
            <path
              d="M81 46C87 44 93 44 98 45M81 56C87 54 93 54 98 55M70 66C80 63 89 63 98 65"
              stroke="var(--blue)"
              stroke-width="2"></path>
          </g>
          <path
            d="M66 30L66 52L71 47.5L76 52L76 29"
            fill="url(#hatch-red)"
            stroke="var(--red)"
            stroke-width="2"
            stroke-linejoin="round"></path>
          <g
            fill="none"
            stroke="var(--red)"
            stroke-width="3.4"
            stroke-linecap="round"
          >
            <path d="M92 9.5C93 3.5 104 2.5 105.5 9.5C106.5 15 99 16 98.5 22"
            ></path>
          </g>
          <circle cx="98.4" cy="28.4" r="2.2" fill="var(--red)"></circle>
        </svg>
        <h3 class="t">Učivo v kontextu dnešní doby</h3>
        <p>Na tyto otázky se ptáme u všech témat z nového RVP:</p>
        <ul class="hand">
          <li>K čemu to musím umět?</li>
          <li>Ve kterých povoláních to využiju?</li>
          <li>Jak se to s AI naučím snadněji?</li>
        </ul>
      </Paper>

      <Paper
        as="a"
        href={`${base}povolani/`}
        seed="home/about/jobs"
        tilt={-0.9}
        depth={3}
        tone="#fff"
        class="offer jobs"
      >
        <svg
          class="doodle"
          viewBox="0 0 120 96"
          aria-hidden="true"
          focusable="false"
        >
          <g
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M46 40V32C46 27.5 72 27 72 32V40"></path>
            <path
              d="M20 40.5C44 38.5 76 39 99 40L98.5 84C75 85.5 44 85 20.5 84Z"
              fill="#fff"></path>
            <path d="M20.5 59C46 61.5 74 61.5 98.8 59"></path>
          </g>
          <path
            d="M53 55H66V65H53Z"
            fill="url(#hatch-blue)"
            stroke="var(--blue)"
            stroke-width="2"
            stroke-linejoin="round"></path>
          <g
            fill="none"
            stroke="var(--blue)"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M80 30L91 20L97 25L110 9"></path>
            <path d="M101 8.5H110.5V18"></path>
          </g>
          <path
            d="M14 8C15 15 17.5 17.5 24.5 18.5C17.5 19.5 15 22 14 29C13 22 10.5 19.5 3.5 18.5C10.5 17.5 13 15 14 8Z"
            fill="url(#hatch-red)"
            stroke="var(--red)"
            stroke-width="1.8"
            stroke-linejoin="round"></path>
        </svg>
        <h3 class="t">Povolání budoucnosti</h3>
        <p>U jednotlivých povolání z evropské databáze ESCO se ptáme:</p>
        <ul class="hand">
          <li>Co ze školy v něm potřebuji?</li>
          <li>Jak moc bude potřeba v roce 2035?</li>
          <li>Jak jeho práci mění AI?</li>
        </ul>
      </Paper>
    </div>

    <p class="about-foot">
      Projekt vychází z veřejně dostupných dat (ESCO, Cedefop a ILO), při analýze a psaní
      textů pomáhala AI. Za projektem stojí <a href="https://zdenekkasner.cz"
        >Zdeněk Kasner</a
      >.<br />
      <a href={`${base}o-projektu/`}>Více o projektu</a>
    </p>
  </Paper>
</section>

<style>
  .about {
    max-width: 1040px;
    width: 100%;
    margin-inline: auto;
  }
  .about :global(.about-sheet) {
    padding: clamp(var(--s5), 4vw, var(--s7));
    display: grid;
    gap: var(--s5);
  }
  .about-h {
    text-align: center;
    font-size: calc(clamp(2rem, 5vw, 3.2rem) * var(--title-scale));
    line-height: 1.05;
  }
  .about-note {
    justify-self: center;
    text-align: center;
    margin: calc(-1 * var(--s4)) 0 0;
    font-family: "Mynerve", cursive;
    font-weight: 700;
    font-size: clamp(1.2rem, 2.6vw, 1.6rem);
    color: var(--red);
    rotate: -2deg;
  }
  .about-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s6);
    align-items: start;
    max-width: 860px;
    width: 100%;
    margin-inline: auto;
  }
  .about :global(a.offer) {
    display: grid;
    gap: var(--s2);
    align-content: start;
    justify-items: center;
    text-align: center;
    padding: var(--s4) var(--s5) var(--s5);
    color: inherit;
  }
  .doodle {
    width: 128px;
    height: auto;
    color: var(--ink);
    margin-bottom: var(--s1);
  }
  .about :global(.offer) h3 {
    font-size: calc(1.8rem * var(--title-scale));
  }
  .about :global(.offer) p {
    margin: 0;
  }
  .hand {
    list-style: none;
    margin: var(--s1) 0 0;
    padding: 0;
    display: grid;
    gap: 2px;
    font-family: "Mynerve", cursive;
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1.25;
    color: var(--purple);
  }
  .hand li:nth-child(2) {
    rotate: -1deg;
  }
  .about-foot {
    text-align: center;
    color: var(--ink-soft);
    font-size: 0.9375rem;
    margin: 0;
  }
  .about-foot a {
    font-weight: 600;
    white-space: nowrap;
  }
  @media (max-width: 760px) {
    .about-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s5);
    }
  }
</style>
