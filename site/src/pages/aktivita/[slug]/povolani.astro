---
// All occupations that need a card's skills: the top ones with AI notes, then every one, sorted by how much it uses
// the skill (relevance.py) in sections by level; without scores, by CZ-ISCO major group.
import Base from "../../../layouts/Base.astro";
import Crumbs from "../../../components/Crumbs.astro";
import Icon from "../../../components/Icon.astro";
import Paper from "../../../components/Paper.astro";
import SectionHead from "../../../components/SectionHead.astro";
import Pie from "../../../components/charts/Pie.astro";
import Bars from "../../../components/charts/Bars.astro";
import UseLevel from "../../../components/UseLevel.astro";
import AiLevel from "../../../components/AiLevel.astro";
import CedefopSource from "../../../components/CedefopSource.astro";
import {
  activities, occupations, measures, activityOccupations, jobNotes, relevance, USE_LEVELS, useLevel, ISCO1, isco2, pct, peopleAbout, AI_LEVEL_LEGEND, type Activity,
} from "../../../lib/data";

export function getStaticPaths() {
  return activities.map((a) => ({ params: { slug: a.slug }, props: { a } }));
}
const { a } = Astro.props as { a: Activity };
const base = import.meta.env.BASE_URL;
const m = measures[a.slug];
const notes = jobNotes(a.slug);
const all = (activityOccupations[a.slug] ?? []).map((id) => occupations[id]).filter(Boolean);
const top = (m?.topOccupations ?? []).map((id) => occupations[id]).filter(Boolean);
const share = (x: number) => pct(x, x < 0.1 ? 1 : 0);
const rel = relevance(a.slug);
const scored = all.length > 0 && all.every((o) => rel[o.id] != null);
// Sections by rounded level, highest first; inside, by the precise score.
const levels = [4, 3, 2, 1, 0]
  .map((l) => ({ l, items: all.filter((o) => useLevel(rel[o.id]) === l).sort((x, y) => rel[y.id] - rel[x.id]) }))
  .filter((g) => g.items.length > 0);

const groups = Object.keys(ISCO1)
  .map((k) => ({ k, label: ISCO1[k], items: all.filter((o) => o.isco2?.[0] === k) }))
  .filter((g) => g.items.length > 0)
  .sort((x, y) => (m?.byMajor?.[y.k] ?? 0) - (m?.byMajor?.[x.k] ?? 0));
const barRows = groups.map((g) => ({
  label: g.label,
  value: (m?.byMajor?.[g.k] ?? 0) / (m?.employmentShare || 1),
  display: pct((m?.byMajor?.[g.k] ?? 0) / (m?.employmentShare || 1)),
  href: scored ? undefined : `#g${g.k}`,
}));
---
<Base title={`${a.title}: povolání`} description={`Povolání, která podle ESCO potřebují dovednosti z karty ${a.title}.`}>
  <div class="wrap page">
    <Crumbs items={[{ label: a.title, href: `${base}aktivita/${a.slug}/` }, { label: "Povolání" }]} />
    <section class="lead col">
      <h1>{a.title}: povolání</h1>
      {m && <p class="soft">Podle evropské databáze ESCO je dovednost z této karty nezbytná v {all.length.toLocaleString("cs-CZ")} povoláních. ESCO ji uvádí jen tam, kde je pro práci výslovně důležitá, a často jde o obecnou dovednost, třeba „provádět výpočty“. Proto jsou mezi povoláními i taková, kde se hodí jen část toho, co se učíš.</p>}
    </section>

    {m && (
      <Paper kind="grid" seed={`occ-sum/${a.slug}`} class="summary">
        <div class="work-in">
          <Pie value={m.employmentShare} seed={`occ-pie/${a.slug}`} size={100} label={`${share(m.employmentShare)} pracujících v Česku`} />
          <div>
            <p class="big-num">{share(m.employmentShare)}</p>
            <p class="small">pracujících v Česku, {peopleAbout(m.employment)} lidí (náš odhad)</p>
          </div>
        </div>
        <div class="fig">
          <h2 class="fig-h">Skupiny povolání</h2>
          <Bars rows={barRows} max={1} seed={`occ-bars/${a.slug}`} label="Podíl podle skupin povolání CZ-ISCO" />
        </div>
      </Paper>
    )}

    {top.length > 0 && (
      <section class="section" aria-labelledby="h-top">
        <SectionHead id="h-top" icon="briefcase">Jak tu dovednost používají<Fragment slot="lead"><Icon name="sparkles" size="16" class="ai-mark" /> Popisy napsala AI podle popisu povolání v ESCO. Kde je spojení slabé, píšeme to.</Fragment></SectionHead>
        <ul class="jobs">
          {top.map((j) => (
            <li>
              <Paper as="a" seed={`occ-top/${a.slug}/${j.id}`} tilt={0.8} depth={3} href={`${base}povolani/${j.id}/`} class="job">
                <AiLevel occ={j} class="corner" />
                <span class="t">{j.label}</span>
                {rel[j.id] != null && <UseLevel value={rel[j.id]} />}
                {notes.notes[j.id] && <span class="note small">{notes.notes[j.id]}</span>}
              </Paper>
            </li>
          ))}
        </ul>
        <p class="tiny soft center">{AI_LEVEL_LEGEND}</p>
        <CedefopSource class="center" />
      </section>
    )}

    <section class="section col" aria-labelledby="h-all">
      <SectionHead id="h-all" icon="list">Všechna povolání{scored && <Fragment slot="lead"><Icon name="sparkles" size="16" class="ai-mark" /> Seřazená podle toho, jak moc dovednost v práci využívají. Odhad dělá AI model Jev podle popisu povolání v ESCO.</Fragment>}</SectionHead>
      {scored && levels.map((g) => (
        <Paper as="div" kind="lined" seed={`occ-u/${a.slug}/${g.l}`} tilt={0.2} class="grp" id={`u${g.l}`}>
          <h3>{USE_LEVELS[g.l]} <span class="tiny soft num">{g.items.length}</span></h3>
          <ul>
            {g.items.map((o) => <li><a href={`${base}povolani/${o.id}/`}>{o.label}</a> <AiLevel occ={o} /> <span class="tiny soft">{isco2[o.isco2]?.label}</span></li>)}
          </ul>
        </Paper>
      ))}
      {!scored && groups.map((g) => (
        <Paper as="div" kind="lined" seed={`occ-g/${a.slug}/${g.k}`} tilt={0.2} class="grp" id={`g${g.k}`}>
          <h3>{g.label} <span class="tiny soft num">{g.items.length}</span></h3>
          <ul>
            {g.items.map((o) => <li><a href={`${base}povolani/${o.id}/`}>{o.label}</a> <AiLevel occ={o} /> <span class="tiny soft">{isco2[o.isco2]?.label}</span></li>)}
          </ul>
        </Paper>
      ))}
    </section>
  </div>
</Base>
<style>
  .page { display: grid; gap: var(--s7); }
  .lead { display: grid; justify-items: center; text-align: center; gap: var(--s3); }
  .lead h1 { font-size: calc(clamp(2rem, 5vw, 3rem) * var(--title-scale)); }
  .lead p { max-width: 64ch; }
  .summary { max-width: 900px; width: 100%; margin-inline: auto; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: var(--s5); align-items: center; }
  .work-in { display: flex; align-items: center; gap: var(--s4); }
  .fig { display: grid; gap: var(--s2); }
  .fig-h { font-family: var(--font-body); font-size: 0.875rem; font-weight: 700; }
  .jobs { list-style: none; margin: 0 auto; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: var(--s4); max-width: 1000px; width: 100%; }
  .job { display: grid; gap: 4px; padding: 12px 16px 14px; height: 100%; }
  .job :global(.ai-level.corner) { position: absolute; top: 14px; right: 16px; }
  .job .t { padding-right: 4.6em; }
  .job .t { font-family: var(--font-title); font-weight: var(--title-weight-small); font-size: calc(1.25rem * var(--title-scale)); line-height: 1.15; overflow-wrap: anywhere; }
  .job .note { line-height: 1.45; }
  .job .d { color: var(--ink-soft); font-weight: 600; }
  .grp { padding: var(--s4) var(--s4) var(--s4) 38px; display: grid; gap: var(--s2); scroll-margin-top: var(--s4); }
  /* Hundreds of rows: tilted, the far end of the sheet would stick out of a phone screen (as for .paper.rows). */
  .grp::before, .grp::after { transform: none; }
  .grp h3 { font-size: calc(1.3rem * var(--title-scale)); }
  .grp ul { list-style: none; margin: 0; padding: 0; columns: 2 280px; column-gap: var(--s5); }
  .grp li { break-inside: avoid; padding: 2px 0; font-size: 0.9375rem; line-height: 1.35; }
  .grp li a { text-decoration-color: var(--rule); }
  .grp li .tiny { display: block; }
</style>
