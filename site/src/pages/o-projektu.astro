---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import SectionHead from "../components/SectionHead.astro";
import Paper from "../components/Paper.astro";
import {
  TOOLS,
  VERDICT,
  RULES,
  activities,
  coverage,
  meta,
  CEDEFOP_CITE,
} from "../lib/data";
const reviewed = activities.filter((a) => a.review.reviewed).length;
const CEDEFOP = CEDEFOP_CITE;
const builtIso: string | null = meta.buildDate ?? meta.build_date ?? null;
// "2026-10-29" -> "29. 10. 2026", like the other dates on the page.
const built = builtIso?.replace(/^(\d{4})-(\d{2})-(\d{2}).*/, (_, y, m, d) => `${+d}. ${+m}. ${y}`) ?? null;
const covs = Object.values(coverage);
const nPoints = covs.reduce((n, c) => n + c.points.length, 0);
const nAside = covs.reduce(
  (n, c) => n + c.points.filter((p) => p.aside).length,
  0,
);
// This page speaks neutrally, without addressing the reader (user 2026-10-25); the shared tool and rule texts use
// tykání elsewhere on the site, so the page has its own wording where they differ.
const TOOL_DESC: Record<string, string> = {
  chatbot:
    "Dostane zadání a odpoví celými větami. Třeba ChatGPT, Gemini nebo Claude.",
  internet:
    "Hotové informace k dohledání: vyhledávač, Wikipedie, Internetová jazyková příručka, encyklopedie.",
};
const RULE_TEXT: Record<string, string> = {
  P1: "Z věty v RVP vznikne krátký název činnosti, třeba „Měření pH roztoků“. Nic se nepřidává.",
  P2: "Odborné výrazy nahradíme běžnými slovy nebo je vysvětlíme v názvu. Pojmy, které se mají děti naučit, necháme.",
};
---

<Base title="O projektu">
  <div class="wrap page">
    <section class="lead col">
      <h1>O projektu</h1>
      <p class="lede">
        <i>„Proč se to učím?“</i> To je otázka, kterou si žáci kladli vždycky – dnes
        ale nabývá na zvláštní intenzitě. Schopnosti AI nástrojů dosáhly takové úrovně,
        že se přímo nabízí ztratit motivaci se učit a hodit vzdělání za hlavu. Nebo
        ne?
      </p>

      <p class="lede">
        Tento projekt se snaží ukázat, že <b>AI je jen další nástroj</b> – stejně
        jako kalkulačka, internet nebo mobilní telefon. Nic z toho nenahradí potřebu
        „mít něco v hlavě“.
      </p>
      <p class="lede">
        Ano, AI zvládne (téměř) všechno. Kdo si ale bude muset od AI pokaždé
        nechávat kontrolovat český pravopis, překládat anglické texty, řešit
        logické úlohy nebo vysvětlovat mapu okolí, <b
          >bude za ostatními pozadu</b
        >. AI za nás také nebude hrát v kapele ani nám nebude zlepšovat fyzickou
        kondici. A měli bychom se mít na pozoru, když nám řekne, koho volit.
      </p>
