---
import Base from "../../layouts/Base.astro";
import Crumbs from "../../components/Crumbs.astro";
import Icon from "../../components/Icon.astro";
import SectionHead from "../../components/SectionHead.astro";
import Paper from "../../components/Paper.astro";
import ActivityRow from "../../components/ActivityRow.astro";
import Stack from "../../components/charts/Stack.astro";
import { TOOLS, activities, outcomes, VERDICT, VERDICT_ICON, verdictSegs, type Verdict } from "../../lib/data";

export function getStaticPaths() {
  return TOOLS.map((t) => ({ params: { tool: t.id }, props: { t } }));
}
const { t } = Astro.props as { t: (typeof TOOLS)[number] };
const base = import.meta.env.BASE_URL;
const groups = (["pomuze", "nepomuze"] as Verdict[]).map((v) => ({
  v,
  items: activities.filter((a) => a.tools[t.id].verdict === v),
}));
---
<Base title={t.name}>
  <div class="wrap page">
    <Crumbs items={[{ label: "Nástroje", href: `${base}nastroje/` }, { label: t.name }]} />
    <section class="lead col">
      <Icon name={t.icon} size="52" class="big" />
      <h1>{t.name}</h1>
      <p class="soft">{t.desc}</p>
    </section>
    <Paper seed={`about/${t.id}`} tilt={0.6} class="about col">
      <h2 class="sh-h"><Icon name="lightbulb" size="22" />Proč mě nenahradí?</h2>
      <p>{t.about}</p>
    </Paper>
    <Paper kind="grid" seed={`toolsum/${t.id}`} class="sum">
      <Stack segs={verdictSegs(t.id)} label={`${t.name} u ${activities.length} karet`} height={26} />
      <p class="tiny soft">Počty karet, celkem {activities.length}.</p>
    </Paper>
    {groups.map((g) => (
      <section class="section col" aria-labelledby={`h-${g.v}`}>
        <SectionHead id={`h-${g.v}`} icon={VERDICT_ICON[g.v]}>{VERDICT[g.v]} <span class="count num">({g.items.length})</span></SectionHead>
        {g.items.length > 0 ? (
          <Paper as="ul" kind="lined" seed={`tool/${t.id}/${g.v}`} tilt={0.25} class="rows">
            {g.items.map((a) => <ActivityRow a={a} meta={`${outcomes[a.outcome]?.subject.name} · ${a.tools[t.id].why}`} />)}
          </Paper>
        ) : <p class="soft small center">Zatím nic.</p>}
      </section>
    ))}
  </div>
</Base>
<style>
  .page { display: grid; gap: var(--s7); }
  .lead { display: grid; justify-items: center; text-align: center; gap: var(--s3); }
  .lead :global(.big) { color: var(--purple); }
  .lead p { max-width: 62ch; }
  .about { display: grid; gap: var(--s3); max-width: 700px; padding: var(--s5) var(--s6) var(--s6); }
  .about p { font-size: 1.0625rem; line-height: 1.6; }
  .sh-h { display: flex; align-items: center; gap: var(--s2); font-size: calc(1.4rem * var(--title-scale)); line-height: 1.1;
          padding-bottom: 9px; background: var(--pen-stroke) left bottom / 74px 9px no-repeat; }
  .sh-h :global(.icon) { color: var(--purple); }
  @media (max-width: 560px) { .about { padding: var(--s4) var(--s4) var(--s5); } }
  .sum { max-width: 620px; width: 100%; margin-inline: auto; display: grid; gap: var(--s2); }
  .count { font-family: var(--font-body); font-weight: 500; font-size: 0.9em; margin-left: 0.3em; }
  .section + .section { margin-top: 0; }
</style>
