---
import Base from "../layouts/Base.astro";
import Search from "../components/Search.astro";
import Paper from "../components/Paper.astro";
const base = import.meta.env.BASE_URL;
---
<Base title="Stránka nenalezena">
  <div class="wrap page col" data-search-page>
    <Paper seed="404" tilt={2} class="lost"><span>Tudy cesta nevede</span></Paper>
    <h1>Tahle stránka tu není</h1>
    <p>Možná se změnila adresa, nebo jsme tuhle věc ještě nerozebrali. Zkus ji najít, nebo se vrať na <a href={base}>úvod</a>.</p>
    <Search />
  </div>
</Base>
<style>
  .page { display: grid; justify-items: center; text-align: center; gap: var(--s5); }
  .lost { font-family: var(--font-title); font-weight: var(--title-weight); font-size: calc(1.6rem * var(--title-scale)); color: var(--red); padding: var(--s3) var(--s6); }
  .page :global(.results) { text-align: left; width: 100%; }
</style>
