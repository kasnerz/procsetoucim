---
import Base from "../layouts/Base.astro";
import SubjectRooms from "../components/SubjectRooms.astro";
import SectionHead from "../components/SectionHead.astro";
import Paper from "../components/Paper.astro";
import { subjects, activities, outcomes, subjectSlug } from "../lib/data";
const base = import.meta.env.BASE_URL;
const subs = subjects();
const byArea = new Map<string, typeof subs>();
for (const s of subs) { if (!byArea.has(s.areaName)) byArea.set(s.areaName, []); byArea.get(s.areaName)!.push(s); }
---
<Base title="Předměty">
  <div class="wrap page">
    <section class="lead col">
      <h1>Předměty</h1>
      <p class="soft">Předměty a vzdělávací oblasti podle nového RVP pro základní školy. Každý předmět má svou třídu. Čísla ukazují, kolik karet z předmětu už máme.</p>
    </section>
    <SubjectRooms />
    <section class="section col" aria-labelledby="h-list">
      <SectionHead id="h-list" icon="list">Seznam podle oblastí</SectionHead>
      {[...byArea.entries()].map(([area, list]) => (
        <div class="area">
          <h3 class="center">{area}</h3>
          <Paper as="ul" kind="lined" seed={`area/${area}`} tilt={0.25} class="rows">
            {list.map((s) => {
              const n = activities.filter((a) => outcomes[a.outcome]?.subject.code === s.code).length;
              return <li><a href={`${base}predmet/${subjectSlug(s.code)}/`}><span class="rname">{s.name}</span><span class="meta num">{s.outcomes.length} cílů RVP{n > 0 ? ` · ${n} rozebraných věcí` : ""}</span></a></li>;
            })}
          </Paper>
        </div>
      ))}
    </section>
  </div>
</Base>
<style>
  .page { display: grid; gap: var(--s7); }
  .lead { display: grid; justify-items: center; text-align: center; gap: var(--s3); }
  .lead p { max-width: 60ch; }
  .area { display: grid; gap: var(--s3); }
  .area h3 { font-size: calc(1.4rem * var(--title-scale)); }
</style>
