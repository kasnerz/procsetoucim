---
// One RVP goal: every official point and what became of it (cards, or why it was set aside).
import Base from "../../layouts/Base.astro";
import Crumbs from "../../components/Crumbs.astro";
import Icon from "../../components/Icon.astro";
import Paper from "../../components/Paper.astro";
import SectionHead from "../../components/SectionHead.astro";
import Stack from "../../components/charts/Stack.astro";
import ActivityRow from "../../components/ActivityRow.astro";
import {
  outcomes, activitiesFor, activityBySlug, coverage, ASIDE, subjectSlug, subjectIcon, outcomeSlug, type Outcome,
} from "../../lib/data";

export function getStaticPaths() {
  return Object.values(outcomes).map((o) => ({ params: { code: outcomeSlug(o.code) }, props: { o } }));
}
const { o } = Astro.props as { o: Outcome };
const base = import.meta.env.BASE_URL;
const acts = activitiesFor(o.code);
const cov = coverage[o.code];
const prev = o.prev.map((c) => outcomes[c]).filter(Boolean);
const next = o.next.map((c) => outcomes[c]).filter(Boolean);
const isSubject = o.kind === "obor";
const crumbs = [
  isSubject ? { label: o.subject.name, href: `${base}predmet/${subjectSlug(o.subject.code)}/` } : { label: o.subject.name },
  { label: `${o.stageLabel}${o.okruh ? ` · ${o.okruh.name}` : ""}` },
];
const strip = (t: string) => t.replace(/\.\s*$/, "");
const LEVELS = ["Na začátku", "Na cestě", "Splněno", "Minimální doporučená úroveň"];
const byLevel = cov ? LEVELS.map((l) => ({ l, pts: cov.points.filter((p) => p.level === l) })).filter((g) => g.pts.length) : [];
const nCards = cov ? cov.points.filter((p) => p.cards.length).length : 0;
const nAside = cov ? cov.points.filter((p) => p.aside).length : 0;
const card = (slug: string) => activityBySlug.get(slug);
---
<Base title={o.text}>
  <div class="wrap page">
    <Crumbs items={crumbs} />
    <section class="lead col">
      <Icon name={isSubject ? subjectIcon(o.subject.code) : "layers"} size="42" class="subj" />
      <h1>{o.text}</h1>
      <p class="soft small">Cíl z RVP, který mají děti splnit {o.stageLabel}. <a href={o.url} rel="external">Oficiální znění na prohlednout.rvp.cz</a> <span class="num">{o.code}</span></p>
    </section>

    {cov ? (
      <section class="section" aria-labelledby="h-pts">
        <SectionHead id="h-pts" icon="file-text">Body z RVP a karty<Fragment slot="lead">RVP popisuje cíl po úrovních. Každý bod jsme převedli na kartu podle <a href={`${base}o-projektu/#pravidla`}>pravidel zjednodušení</a>, nebo píšeme, proč kartu nemá.</Fragment></SectionHead>
        <Paper kind="grid" seed={`cov-sum/${o.code}`} class="cov-sum">
          <p><span class="big-num">{cov.points.length}</span> <span class="small">bodů v RVP</span></p>
          <Stack segs={[
            { value: nCards, label: `převedeno na ${acts.length} karet`, fill: "f-blue-solid" },
            { value: nAside, label: "bez karty, s důvodem", fill: "f-light" },
          ]} label="Body cíle" />
        </Paper>
        {byLevel.map((g) => (
          <Paper kind="lined" seed={`cov/${o.code}/${g.l}`} tilt={0.2} class="lvl">
            <h3>{g.l}</h3>
            <ul class="pts">
              {g.pts.map((p) => (
                <li>
                  <p class="pt">„{p.point}“</p>
                  <p class="to">
                    <Icon name="arrow-right" size="18" class="arr" />
                    {p.cards.length > 0
                      ? p.cards.map((s) => <a class="chip" href={`${base}aktivita/${s}/`}>{card(s)?.title ?? s}</a>)
                      : p.aside && <span class="aside small">{ASIDE[p.aside.code]}{p.aside.refs.map((s) => <> <a href={`${base}aktivita/${s}/`}>{card(s)?.title ?? s}</a></>)}</span>}
                  </p>
                </li>
              ))}
            </ul>
          </Paper>
        ))}
      </section>
    ) : (
      <section class="section col" aria-labelledby="h-levels">
        <SectionHead id="h-levels" icon="file-text">Jak to popisuje RVP<Fragment slot="lead">Tenhle cíl jsme zatím nerozebrali na karty. Tady je aspoň jeho oficiální popis po úrovních.</Fragment></SectionHead>
        <div class="levels">
          {o.levels.map((l) => (
            <Paper kind="grid" seed={`lvl/${o.code}/${l.name}`} class="lvl">
              <h3>{l.name}</h3>
              <p class="small pre">{l.text}</p>
            </Paper>
          ))}
        </div>
      </section>
    )}

    {acts.length > 0 && (
      <section class="section col" aria-labelledby="h-acts">
        <SectionHead id="h-acts" icon="pencil">Karty k tomuto cíli</SectionHead>
        <Paper as="ul" kind="lined" seed={`acts/${o.code}`} tilt={0.25} class="rows">
          {acts.map((a) => <ActivityRow a={a} meta={`Z úrovní: ${[...new Set(a.levelSource.map((x) => x.level))].join(", ")}`} />)}
        </Paper>
      </section>
    )}

    {o.illustrations.length > 0 && (
      <details class="illus col">
        <summary>Ukázky úloh z RVP ({o.illustrations.length})</summary>
        <ul>
          {o.illustrations.map((i) => (
            <li><strong>{i.title || "Ukázka bez názvu"}</strong> <span class="soft">({i.level})</span>{i.url && <> · <a href={i.url} rel="external">materiál</a></>}</li>
          ))}
        </ul>
      </details>
    )}

    {(prev.length > 0 || next.length > 0) && (
      <div class="links col">
        {prev.length > 0 && (
          <section aria-labelledby="h-prev">
            <h2 id="h-prev" class="lh"><Icon name="layers" size="22" />Na čem to stojí</h2>
            <ul>{prev.map((p) => <li><a href={`${base}vystup/${outcomeSlug(p.code)}/`}><Icon name="arrow-left" size="16" /><span>{strip(p.text)}</span></a> <span class="tiny soft">{p.stageLabel}</span></li>)}</ul>
          </section>
        )}
        {next.length > 0 && (
          <section aria-labelledby="h-next">
            <h2 id="h-next" class="lh"><Icon name="trending-up" size="22" />Co na tom stavíš dál</h2>
            <ul>{next.map((p) => <li><a href={`${base}vystup/${outcomeSlug(p.code)}/`}><Icon name="arrow-right" size="16" /><span>{strip(p.text)}</span></a> <span class="tiny soft">{p.stageLabel}</span></li>)}</ul>
          </section>
        )}
      </div>
    )}
  </div>
</Base>

<style>
  .page { display: grid; gap: var(--s7); }
  .lead { display: grid; justify-items: center; text-align: center; gap: var(--s3); }
  .lead :global(.subj) { color: var(--purple); }
  .lead h1 { font-size: calc(clamp(2rem, 4.5vw, 3rem) * var(--title-scale)); max-width: 26ch; }
  .cov-sum { max-width: 560px; width: 100%; margin-inline: auto; display: grid; gap: var(--s2); }
  .lvl { max-width: 900px; width: 100%; margin-inline: auto; display: grid; gap: var(--s2); padding: var(--s4) var(--s5) var(--s4) 40px; }
  .lvl h3 { font-size: calc(1.35rem * var(--title-scale)); }
  .pts { list-style: none; margin: 0; padding: 0; display: grid; }
  .pts li { display: grid; gap: 2px; padding: var(--s2) 0; border-bottom: 1.5px solid var(--rule); }
  .pts li:last-child { border-bottom: 0; }
  .pt { font-size: 0.9375rem; line-height: 1.45; }
  .to { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; }
  .to :global(.arr) { color: var(--blue); }
  .chip { font-family: var(--font-title); font-weight: var(--title-weight-small); font-size: calc(1.1rem * var(--title-scale)); line-height: 1.2; text-decoration: none; padding: 1px 9px; background: var(--box-line) 0 0 / 100% 100% no-repeat; }
  .chip:hover { color: var(--blue); }
  .aside { color: var(--ink-soft); }
  .levels { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: var(--s4); }
  .pre { white-space: pre-line; }
  .illus ul { margin: var(--s3) 0 0; padding-left: 1.2em; display: grid; gap: var(--s1); }
  .illus summary { text-align: center; font-weight: 600; }
  .links { display: grid; gap: var(--s5); }
  .lh { display: flex; align-items: center; gap: var(--s2); font-size: calc(1.5rem * var(--title-scale)); margin-bottom: var(--s2); }
  .lh :global(.icon) { color: var(--purple); }
  .links ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s2); }
  .links a { display: inline-flex; gap: 6px; align-items: baseline; font-weight: 600; text-decoration: none; }
  .links a :global(.icon) { align-self: center; color: var(--red); flex: none; }
  .links a:hover span { text-decoration: underline; text-decoration-color: var(--blue); }
</style>
